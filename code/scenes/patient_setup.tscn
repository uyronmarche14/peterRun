[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/patient_setup_controller.gd" id="1_setup"]
[ext_resource type="Theme" path="res://art/ui/compact_theme.tres" id="9_compact"]
[ext_resource type="StyleBox" path="res://art/ui/menu_card.tres" id="10_card"]
[ext_resource type="Script" path="res://scripts/barangay_opening_art.gd" id="11_backdrop"]
[ext_resource type="Script" path="res://scripts/repetition_stepper.gd" id="12_stepper"]

[sub_resource type="StyleBoxFlat" id="RowSurface"]
content_margin_left = 8.0
content_margin_top = 4.0
content_margin_right = 8.0
content_margin_bottom = 4.0
bg_color = Color(0.965, 0.925, 0.8, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.82, 0.8, 0.68, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="ChipSurface"]
content_margin_left = 8.0
content_margin_top = 2.0
content_margin_right = 8.0
content_margin_bottom = 2.0
bg_color = Color(0.85, 0.92, 0.87, 1)
corner_radius_top_left = 7
corner_radius_top_right = 7
corner_radius_bottom_right = 7
corner_radius_bottom_left = 7

[node name="PatientSetup" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("9_compact")
script = ExtResource("1_setup")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.027, 0.169, 0.22, 1)

[node name="BackdropArt" type="Node2D" parent="."]
modulate = Color(0.9, 0.95, 0.9, 1)
script = ExtResource("11_backdrop")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchor_left = 0.24
anchor_top = 0.48
anchor_right = 0.76
anchor_bottom = 0.52
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = ExtResource("10_card")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="Content" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="VBoxContainer" parent="Panel/Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 1

[node name="Title" type="Label" parent="Panel/Margin/Content/Header"]
layout_mode = 2
