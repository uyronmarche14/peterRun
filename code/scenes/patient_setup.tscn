theme_override_font_sizes/font_size = 13
text = "Set up this session"
horizontal_alignment = 1

[node name="Guidance" type="Label" parent="Panel/Margin/Content/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.36, 0.42, 0.42, 1)
theme_override_font_sizes/font_size = 8
